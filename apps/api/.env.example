PORT=
WEB_ORIGIN=http://localhost:5177
DATABASE_URL=
REDIS_URL=
NODE_ENV=development
JWT_SECRET=replace-with-at-least-32-random-characters
# off = no money features · test = Paystack sandbox (sk_test_ key) · live = production only (sk_live_ key)
PAYMENTS_MODE=off
PAYSTACK_SECRET_KEY=
# ZeptoMail (transactional email). Use the "Send Mail" token from your Mail Agent; the
# "Zoho-enczapikey " prefix is optional. Use https://api.zeptomail.eu/v1.1/email etc. for non-US data centres.
ZEPTOMAIL_API_KEY=
ZEPTOMAIL_API_URL=https://api.zeptomail.com/v1.1/email
ZEPTOMAIL_FROM_ADDRESS=noreply@yourdomain.com
ZEPTOMAIL_FROM_NAME=Jump

# Profile photos (Cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Strava (https://www.strava.com/settings/api). Set the app's Authorization Callback Domain to the web host.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Any random string; Strava echoes it back when the webhook subscription is created.
STRAVA_WEBHOOK_VERIFY_TOKEN=
# Set to true once Strava approves the app for more athletes; until then Strava sign-in/connect stay hidden.
STRAVA_PUBLIC=false
