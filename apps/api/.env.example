PORT=
WEB_ORIGIN=http://localhost:5177
DATABASE_URL=
REDIS_URL=
NODE_ENV=development
JWT_SECRET=replace-with-at-least-32-random-characters
# off = no money features · test = Paystack sandbox (sk_test_ key) · live = production only (sk_live_ key)
PAYMENTS_MODE=off
PAYSTACK_SECRET_KEY=
# ZeptoMail (transactional email). Use the "Send Mail" token from your Mail Agent; the
# "Zoho-enczapikey " prefix is optional. Use https://api.zeptomail.eu/v1.1/email etc. for non-US data centres.
ZEPTOMAIL_API_KEY=
ZEPTOMAIL_API_URL=https://api.zeptomail.com/v1.1/email
ZEPTOMAIL_FROM_ADDRESS=noreply@yourdomain.com
ZEPTOMAIL_FROM_NAME=Jump
